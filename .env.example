PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Moscow
CHECK_TIME=20:00
CHECK_ON_START=false

# demo — учебные данные на 30 машин
# assist — бесплатный API Assist (200 запросов/мес)
# cloud — API-CLOUD
# http — ваш легальный API (ГИС ГМП, агрегатор по договору)
# Пусто: assist при наличии ASSIST_API_KEY, иначе demo
FINES_PROVIDER=

# Бесплатный ключ: письмо на support@api-assist.com
# https://api-assist.com/api/fines
ASSIST_API_KEY=

# Запасной платный агрегатор https://api-cloud.ru/gibdd
CLOUD_API_TOKEN=

FINES_API_URL=
FINES_API_TOKEN=

# Для http-провайдера лучше 2 потока и пауза 1500 мс.
CHECK_CONCURRENCY=
REQUEST_DELAY_MS=
RETRY_ATTEMPTS=3

VEHICLES_FILE=config/vehicles.json
DATA_FILE=data/state.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
API_TOKEN=
