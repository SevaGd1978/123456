PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Moscow
CHECK_TIME=20:00
CHECK_ON_START=false

# demo — учебные данные
# assist — API Assist (200 бесплатных / платный лимит по письму)
# cloud — платный API-CLOUD для ежедневных 30 машин
# http — свой договорной API
# Пусто: assist при ASSIST_API_KEY, cloud при CLOUD_API_TOKEN, иначе demo
FINES_PROVIDER=

# --- Бесплатно или платно: API Assist ---
# Ключ: письмо на support@api-assist.com
# Бесплатно 200 запросов/мес; на 30 машин каждый день просите ≥ 900/мес
# https://api-assist.com/api/fines
ASSIST_API_KEY=

# --- Платно: API-CLOUD (юрлицо / ИП, ЭДО) ---
# 1) Тарифы: https://api-cloud.ru/tarif
# 2) Заявка: support@api-cloud.ru (методы fines, ~900 запросов/мес, реквизиты, ЭДО)
# 3) Токен из кабинета → сюда, FINES_PROVIDER=cloud
# Документация: https://api-cloud.ru/gibdd
CLOUD_API_TOKEN=

# --- Свой HTTP API ---
# GET {FINES_API_URL}?plate=&sts=  →  { "fines": [...] }
FINES_API_URL=
FINES_API_TOKEN=

# Для http-провайдера лучше 2 потока и пауза 1500 мс.
CHECK_CONCURRENCY=
REQUEST_DELAY_MS=
RETRY_ATTEMPTS=3

VEHICLES_FILE=config/vehicles.json
DATA_FILE=data/state.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
API_TOKEN=
